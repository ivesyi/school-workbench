{
  "name": "@school-workbench/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "build:methodology-cli": "esbuild src/activate-methodology-pack-main.ts --bundle --platform=node --format=esm --outfile=dist/activate-methodology-pack.mjs --external:better-sqlite3"
  },
  "dependencies": {
    "@school-workbench/application": "workspace:*",
    "@school-workbench/assessment": "workspace:*",
    "@school-workbench/domain": "workspace:*",
    "@school-workbench/methodology": "workspace:*",
    "@school-workbench/workbench-read-plane": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
