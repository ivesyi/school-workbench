  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@school-workbench/workbench-read-plane": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
