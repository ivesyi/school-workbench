  "evidenceGuidance": [
    {
      "criterionId": "DW.C1.LEARNING_PROBLEM_QUALITY",
      "supportingIndicators": [
        "连接优先问题；使用多类证据；同时识别学习者资产与重要差距；在学校可影响范围内；具体、可行动。"
      ],
      "counterIndicators": ["问题描述成人不满意、课程覆盖或学生标签，却没有可观察的学习表现。"],
      "insufficientEvidence": ["只有汇总成绩，无法区分任务、群体、体验或具体表现。"],
      "counterexampleChecks": [],
      "collectionPrinciples": [],
      "adjustmentConditions": []
    },
    {
      "criterionId": "DW.C2.PRACTICE_VISIBILITY",
      "supportingIndicators": [
        "团队结合产物、自述、观察或视频，关注教师、学习者、内容与任务之间实际发生的互动。"
      ],
      "counterIndicators": [
        "只看教案中的“规定任务”，不看课堂中的“实际任务”；以自报替代全部实践证据。"
      ],
      "insufficientEvidence": [],
      "counterexampleChecks": [],
      "collectionPrinciples": ["观察用于学习，不用于绩效评价；记录先保持客观、具体，再解释。"],
      "adjustmentConditions": []
    },
    {
      "criterionId": "DW.C3.PROBLEM_OF_PRACTICE_QUALITY",
      "supportingIndicators": [
        "与学习问题相关；基于成人实践证据；承认教育者已有优势和下一步工作；在控制范围内；具体、可行动。"
      ],
      "counterIndicators": ["归咎学生、家庭或不可控环境；直接跳到解决方案；用人格标签解释实践。"],
      "insufficientEvidence": [],
      "counterexampleChecks": ["同一实践是否在某些学习者、课程或条件下产生不同结果？"],
      "collectionPrinciples": [],
      "adjustmentConditions": []
    },
    {
      "criterionId": "DW.C4.INFERENCE_DISCIPLINE",
      "supportingIndicators": [
        "事实、解释、结论分开记录；团队能回到低推论、具体的描述，并主动寻找矛盾证据。"
      ],
      "counterIndicators": ["从单个片段跳到能力、动机或因果判断；只进行避免分歧的“正向闲谈”。"],
      "insufficientEvidence": [],
      "counterexampleChecks": [],
      "collectionPrinciples": [],
      "adjustmentConditions": []
    },
    {
      "criterionId": "DW.C5.ACTION_IMPACT_COHERENCE",
      "supportingIndicators": [
        "行动计划明确谁、做什么、何时做；策略具有杠杆作用；影响计划同时观察学习者体验和表现，并有可测目标。"
      ],
      "counterIndicators": ["只记录培训完成率、教师满意度或交付物；没有学习者层面的影响证据。"],
      "insufficientEvidence": [],
      "counterexampleChecks": [],
      "collectionPrinciples": [],
      "adjustmentConditions": ["预先说明什么证据会支持继续、修改或停止当前行动。"]
    }
  ],
