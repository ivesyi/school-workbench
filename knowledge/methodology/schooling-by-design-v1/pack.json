      "insufficientEvidence": [],
      "counterexampleChecks": ["是否存在相同资料可以支持的另一种差距解释？"],
      "collectionPrinciples": [],
      "adjustmentConditions": []
    },
    {
      "criterionId": "SBD.C4.SYSTEM_ALIGNMENT",
      "supportingIndicators": ["课程、评价、专业学习、领导行为、资源和政策相互强化。"],
      "counterIndicators": ["目标要求一种实践，但时间、考核、资源或领导信号奖励另一种实践。"],
