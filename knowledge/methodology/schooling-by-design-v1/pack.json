      "criterionId": "SBD.C1.RESULT_CLARITY",
      "supportingIndicators": [
        "使命被转译为具体的学习者理解、能力、态度或长期表现；阶段目标可辨认。"
      ],
      "counterIndicators": ["目标只写活动、口号、覆盖率或投入量；不同团队对成功含义不一致。"],
