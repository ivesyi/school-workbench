      "counterexampleChecks": [],
      "collectionPrinciples": [],
      "adjustmentConditions": []
    },
    {
      "criterionId": "SBD.C2.EVIDENCE_BEFORE_ACTION",
      "supportingIndicators": ["行动前已定义成功表现、基线、进展指标与取证方式。"],
      "counterIndicators": ["先确定培训、课程或制度，再事后寻找能证明其有效的数据。"],
