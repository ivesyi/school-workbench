      "counterexampleChecks": [],
      "collectionPrinciples": [],
      "adjustmentConditions": []
    },
    {
      "criterionId": "SBD.C3.GAP_GROUNDED",
      "supportingIndicators": ["目标与现实使用可比证据描述，并承认数据限制或人群差异。"],
